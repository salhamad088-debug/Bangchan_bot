import os
import asyncio
from telegram import Update
from telegram.ext import ApplicationBuilder, MessageHandler, ContextTypes, filters

# ===== CONFIG =====
TOKEN = os.environ["TOKEN"]       # Read from Railway environment variables
OWNER_ID = int(os.environ["OWNER_ID"])
BOT_NAME = "BANG CHAN"

# Automatic messages
AUTO_MESSAGES = [
    "هلا 😌",
    "وش اخباركم اليوم؟",
    "أنا متزوج، بس حبيت أسلم عليكم ❤️",
]

# ===== Auto messages function =====
async def send_auto_messages(app):
    await app.start()
    while True:
        updates = await app.bot.get_updates()
        for update in updates:
            if update.message:
                chat_id = update.message.chat.id
                for msg in AUTO_MESSAGES:
                    await app.bot.send_message(chat_id=chat_id, text=msg)
                    await asyncio.sleep(60 * 5)  # every 5 minutes
        await asyncio.sleep(10)

# ===== Message handler =====
async def group_reply(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message or not update.message.text:
        return

    text = update.message.text.lower()
    user_id = update.message.from_user.id

    # Greetings
    if text in ["هلا", "مرحبا", "السلام عليكم", "hi", "hello"]:
        await update.message.reply_text("هلا 👋")
        return

    # Romantic / inappropriate words
    bad_words = ["حبيبي", "حياتي", "تعال خاص", "احبك", "😘", "❤️"]
    if any(word in text for word in bad_words):
        if user_id == OWNER_ID:
            await update.message.reply_text("😌")  # Romantic only for you
        else:
            await update.message.reply_text("آسف، أنا لا أتصرف رومانسياً إلا مع مالكي 😏")
        return

    # Rude words
    rude_words = ["غبي", "كلب", "حمار", "stupid", "fuck"]
    if any(word in text for word in rude_words):
        await update.message.reply_text("أسلوبك مو مقبول. خلّك محترم.")
        return

    # General help / friendly replies
    if "?" in text or "help" in text or "كيف" in text:
        await update.message.reply_text("أكيد! أنا هنا لمساعدتك 😎")
        return

# ===== Build bot =====
app = ApplicationBuilder().token(TOKEN).build()
app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, group_reply))

# ===== Run bot =====
async def main():
    asyncio.create_task(send_auto_messages(app))
    await app.run_polling()

asyncio.run(main())
